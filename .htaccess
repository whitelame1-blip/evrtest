<Files ".env">
    Order allow,deny
    Deny from all
</Files>
# ----------------------------------------------------------------------
# 1. SECURITY & ACCESS CONTROL
# ----------------------------------------------------------------------

# Prevent directory browsing (users won't see a list of your files)
Options -Indexes

# Protect the .htaccess file itself
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Protect your configuration file (localhost.php)
<Files localhost.php>
    Order allow,deny
    Deny from all
</Files>

# ----------------------------------------------------------------------
# 2. HTTPS REDIRECT & BASE SETTINGS
# ----------------------------------------------------------------------
RewriteEngine On

# CRITICAL: Tell Apache you are working inside this specific folder
RewriteBase /ieltsaireadinggenerator/

# Force HTTPS only if NOT on localhost
RewriteCond %{HTTP_HOST} !^localhost$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ----------------------------------------------------------------------
# 3. CLEAN URLS (Remove .php extensions)
# ----------------------------------------------------------------------

# A. External Redirect: Change /dashboard.php to /dashboard
# ADDED: RewriteCond %{HTTP:X-Requested-With} !=XMLHttpRequest
# This ensures that JS fetch calls don't get forced into a browser redirect
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*)\.php[\s\?] [NC]
RewriteCond %{HTTP:X-Requested-With} !=XMLHttpRequest
RewriteRule ^(.*)\.php$ $1 [R=301,L,NC]

# B. Internal Rewrite: Make /dashboard actually load dashboard.php
# This stays the same - it happens invisibly behind the scenes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]
# ----------------------------------------------------------------------
# 4. SECURITY HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    
    # ONLY set HSTS (Strict-Transport-Security) if we are NOT on localhost
    SetEnvIf Host "^localhost$" is_local
    SetEnvIf Host "^127\.0\.0\.1$" is_local
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=!is_local
</IfModule>
# ----------------------------------------------------------------------
# 5. CACHING FOR PERFORMANCE
# ----------------------------------------------------------------------

<IfModule mod_expires.c>
    ExpiresActive On
    
    # Cache images for 1 month
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    
    # Cache CSS and JS for 1 month (helps with dashboard load speed)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # Do NOT cache HTML or PHP (ensures users see real-time credit updates)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# 6. PYTHON BRIDGE PROXY (Optional)
# ----------------------------------------------------------------------

# If you want to access your Python API via /ai-api/ instead of :5000
# Note: This requires mod_proxy to be enabled on your server
# RewriteRule ^ai-api/(.*)$ http://127.0.0.1:5000/$1 [P,L]